    {"name": "Isrc", "target": "smu.current", "min": -0.01, "max": 0.01, "ramp_rate": 0.01},
    {"name": "Vg", "target": "smu2.voltage1", "min": -5, "max": 5, "ramp_rate": 1},
    {"name": "Ig", "target": "smu2.current1"},
