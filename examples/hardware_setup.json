    {"name": "lockin", "driver": "sr830", "address": "SIM::sr830", "options": {}},
    {"name": "dmm", "driver": "hp34401a", "address": "SIM::hp34401", "options": {}},
    {"name": "daq", "driver": "ni6211", "address": "DAQ::SIM", "options": {"rate": 10000, "samples": 100}}
  ],
  "aliases": [
