    {"name": "Y", "target": "lockin.Y"},
    {"name": "Vaux", "target": "lockin.aux_out1", "min": -2, "max": 2, "ramp_rate": 1},
    {"name": "Vdmm", "target": "dmm.Vdc"},
    {"name": "Vdaq", "target": "daq.ao0", "min": -5, "max": 5, "ramp_rate": 10},
    {"name": "ai0", "target": "daq.ai0"}
