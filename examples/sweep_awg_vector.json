        {
          "channel": "Vg",
          "start": -0.2,
          "stop": 0.2
        }
      ],
      "record": [
        "awg_rms",
        "I"
      ]
    }
  ],
  "pre": {
    "hook": "set_raw('awg.run', 'RUN')",
    "constants": [],
    "record": []
  },
  "post": {
    "hook": "set_raw('awg.run', 'STOP')",
    "constants": [],
    "record": []
  },
  "metadata": {
    "comment": "vector-valued sweep channel (mapping mandatory)"
  }
}