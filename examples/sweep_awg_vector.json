{
  "name": "awg_waveform_amplitude",
  "dimensions": [
    {
      "points": 21,
      "sweep": [
        {
          "channel": "wave",
          "start": 0,
          "stop": 2,
          "mapping": "x*np.sin(np.linspace(0, 2*np.pi, 128))"
