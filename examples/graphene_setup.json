{
  "format": "easyMeasure-setup-1",
  "instruments": [
    {
      "name": "bg",
      "driver": "sim_smu",
      "address": "NONE",
      "options": {}
    },
    {
      "name": "ilockin",
      "driver": "sim_lockin",
      "address": "NONE",
      "options": {
        "sample": "graphene",
        "measure": "current",
        "source": "lockin.amplitude"
      }
    },
    {
      "name": "lockin",
      "driver": "sim_lockin",
      "address": "NONE",
      "options": {
        "sample": "graphene"
      }
    },
    {
      "name": "magnet",
      "driver": "sim_magnet",
      "address": "NONE",
      "options": {}
    },
    {
      "name": "tg",
      "driver": "sim_smu",
      "address": "NONE",
      "options": {}
    }
  ],
  "parameters": [
    {
      "name": "Cb",
      "value": 0.6,
      "unit": "1e12 cm^-2/V",
      "description": "back-gate capacitance / e"
    },
    {
      "name": "Ct",
      "value": 0.9,
      "unit": "1e12 cm^-2/V",
      "description": "top-gate capacitance / e"
    },
    {
      "name": "n0",
      "value": -0.15,
      "unit": "1e12 cm^-2",
      "description": "intrinsic doping"
    },
    {
      "name": "kD",
      "value": 0.0452,
      "unit": "V/nm per 1e12 cm^-2",
      "description": "e / 2 eps0"
    }
  ],
  "aliases": [
    {
      "name": "Vbg",
      "target": "bg.voltage",
      "min": -10,
      "max": 10,
      "ramp_rate": 5,
      "unit": "V",
      "description": "back gate"
    },
    {
      "name": "Ileak",
      "target": "bg.current",
      "unit": "A",
      "description": "back-gate leakage current"
    },
    {
      "name": "Vxx",
      "target": "lockin.X",
      "unit": "V",
      "description": "four-probe voltage"
    },
    {
      "name": "I",
      "target": "ilockin.X",
      "unit": "A",
      "description": "AC current through the sample"
    },
    {
      "name": "B",
      "target": "magnet.field",
      "min": -9,
      "max": 9,
      "unit": "T",
      "description": "magnetic field"
    },
    {
      "name": "Vtg",
      "target": "tg.voltage",
      "min": -10,
      "max": 10,
      "ramp_rate": 5,
      "unit": "V",
      "description": "top gate"
    }
  ],
  "composites": [
    {
      "type": "multi",
      "name": "nD",
      "variables": [
        {
          "name": "n",
          "min": -4,
          "max": 4,
          "unit": "1e12 cm^-2",
          "description": "carrier density"
        },
        {
          "name": "D",
          "min": -0.45,
          "max": 0.45,
          "unit": "V/nm",
          "description": "displacement field"
        }
      ],
      "targets": {
        "Vbg": "(n - n0 + D/kD) / (2*Cb)",
        "Vtg": "(n - n0 - D/kD) / (2*Ct)"
      },
      "description": "carrier density and displacement field of the dual-gated bilayer",
      "out_of_range": "skip"
    },
    {
      "type": "read",
      "name": "Rxx",
      "expression": "Vxx / I",
      "unit": "Ω",
      "description": "four-probe resistance"
    }
  ],
  "monitor": [
    {
      "channel": "Rxx",
      "interval": 0.5
    },
    {
      "channel": "Ileak",
      "interval": 1.0
    },
    {
      "channel": "B",
      "interval": 1.0
    }
  ],
  "actions": [
    {
      "name": "gates_to_zero",
      "code": "set_many({'Vbg': 0, 'Vtg': 0})\nprint('both gates at 0 V')",
      "description": "ramp both gates to 0 V",
      "confirm": false
    }
  ]
}
