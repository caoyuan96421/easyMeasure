{
  "name": "SHG_halfwave_1s",
  "dimensions": [
    {
      "points": 61,
      "sweep": [
        {
          "channel": "halfwave",
          "start": 28,
          "stop": 208
        }
      ],
      "pre_delay": 0.1,
      "record": [
        "ZWOSpectrum",
        "ZWOPhase",
        "ZWOAmplitude",
        "ZWORefPhase",
        "ZWORefAmplitude",
        "SHGframe",
        "@elapsed"
      ],
      "hooks": {
        "pre_record": {
          "enabled": true,
          "code": "from shg_addon.actions import execute\nexecute(globals(), 'acquire_point', **{})"
        }
      }
    }
  ],
  "pre": {
    "hook": "from shg_addon.actions import execute\nexecute(globals(), 'prepare_scan', **{})",
    "constants": [
      {
        "channel": "camera.exposure",
        "value": 1.0
      }
    ]
  },
  "post": {
    "hook": "",
    "constants": [],
    "record": []
  },
  "on_read_error": "abort",
  "on_set_error": "abort",
  "run_post_on_abort": true,
  "metadata": {
    "comment": "SHG: fresh sample spectrum, phase and amplitude at each point. Prepare ROI, background and calibration first."
  }
}
